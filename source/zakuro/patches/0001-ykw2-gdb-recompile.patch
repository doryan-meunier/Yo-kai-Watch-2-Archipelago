+/// svcOpenProcess(pid): a handle to the title's own process, the only one
+/// there is. code that makes its own memory executable (a mod's loader, as
+/// Magikoopa's) opens itself this way, svcControlProcessMemory refusing the
+/// pseudo-handle on the console.
+fn open_process(system: &mut System) {
+    let pid = system.cpu.regs[1];
+    if pid != system.kernel.process_id {
+        log::warn!("svcOpenProcess of process {pid}, not the title's");
+        system.cpu.regs[0] = errors::INVALID_HANDLE.0;
+        return;
+    }
+    let object = system.kernel.objects.insert(KObject::Process);
+    let handle = system.kernel.handles.create(&mut system.kernel.objects, object, "Process");
+    system.cpu.regs[0] = 0;
+    system.cpu.regs[1] = handle;
+}
+
+/// svcControlProcessMemory(process, addr0, addr1, size, operation,
+/// permissions): accepted as svcControlMemory's protection is, nothing
+/// enforces permissions yet (memory that reads can run).
+fn control_process_memory(system: &mut System) {
+    let operation = system.cpu.regs[4];
+    if operation != 6 {
+        log::warn!("svcControlProcessMemory with operation 0x{operation:X}, accepted without effect");
+    }
+    system.cpu.regs[0] = 0;
+}
+
 fn get_resource_limit(system: &mut System) {
     let _process = system.cpu.regs[1];
     let object = system.kernel.objects.insert(KObject::ResourceLimit);
