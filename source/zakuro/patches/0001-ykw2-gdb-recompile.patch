diff --git a/crates/zakuro/src/gdb.rs b/crates/zakuro/src/gdb.rs
new file mode 100644
index 0000000..0fef57e
--- /dev/null
+++ b/crates/zakuro/src/gdb.rs
@@ -0,0 +1,242 @@
+//! a small GDB remote stub, enough for a tool that reads and writes the
+//! game's memory while it plays (the Yo-kai Watch 2 Archipelago client):
+//! `?`, the interrupt byte, `c`, `m`, `M` and `D`. packets are handled
+//! between frames, the game stopped or running.
+//!
+//! unlike Citra's and Azahar's stub, this one keeps listening when its
+//! client goes away, and the game runs on.
+
+use std::io::{ErrorKind, Read, Write};
+use std::net::{TcpListener, TcpStream};
+use std::time::{Duration, Instant};
+
+use zakuro_core::System;
+
+/// the largest block one `m` or `M` packet may carry.
+const MAX_BLOCK: usize = 0x1000;
+
+/// how long a stopped game waits for the next packet before going back to
+/// the window's events, so that it stays responsive while stopped.
+const STOPPED_WAIT: Duration = Duration::from_millis(30);
+
+pub struct Stub {
+    listener: TcpListener,
+    client: Option<TcpStream>,
+    buffer: Vec<u8>,
+    halted: bool,
+}
+
+impl Stub {
+    /// listens on 127.0.0.1:port.
+    pub fn listen(port: u16) -> std::io::Result<Stub> {
+        let listener = TcpListener::bind(("127.0.0.1", port))?;
+        listener.set_nonblocking(true)?;
+        log::info!("gdb: listening on 127.0.0.1:{port}");
+        Ok(Stub { listener, client: None, buffer: Vec::new(), halted: false })
+    }
+
+    /// the client stopped the game.
+    pub fn halted(&self) -> bool {
+        self.halted && self.client.is_some()
+    }
+
+    /// accepts a client and answers what it sent. while the game is stopped
+    /// it waits a little for more, so that a run of writes goes through in
+    /// one go instead of one a frame.
+    pub fn poll(&mut self, mut system: Option<&mut System>) {
+        if self.client.is_none() {
+            match self.listener.accept() {
+                Ok((stream, peer)) => {
+                    if stream.set_nonblocking(true).is_ok() {
+                        let _ = stream.set_nodelay(true);
+                        log::info!("gdb: client {peer} connected, the game stops until it continues");
+                        self.client = Some(stream);
+                        self.buffer.clear();
+                        // as Citra's stub does, the game stops when a client comes
+                        self.halted = true;
+                    }
+                }
+                Err(error) if error.kind() == ErrorKind::WouldBlock => {}
+                Err(error) => log::warn!("gdb: accept: {error}"),
+            }
+        }
+        let start = Instant::now();
+        loop {
+            let got = self.receive();
+            self.handle(system.as_deref_mut());
+            if self.client.is_none() {
+                self.halted = false;
+                return;
+            }
+            if !self.halted {
+                return;
+            }
+            if !got {
+                if start.elapsed() >= STOPPED_WAIT {
+                    return;
+                }
+                std::thread::sleep(Duration::from_micros(500));
+            }
+        }
+    }
+
+    /// reads what arrived, false when nothing did.
+    fn receive(&mut self) -> bool {
+        let Some(client) = &mut self.client else { return false };
+        let mut chunk = [0u8; 16384];
+        let mut got = false;
+        loop {
+            match client.read(&mut chunk) {
+                Ok(0) => {
+                    log::info!("gdb: client gone, the game runs on");
+                    self.client = None;
+                    return got;
+                }
+                Ok(n) => {
+                    self.buffer.extend_from_slice(&chunk[..n]);
+                    got = true;
+                }
+                Err(error) if error.kind() == ErrorKind::WouldBlock => return got,
+                Err(error) if error.kind() == ErrorKind::Interrupted => {}
+                Err(error) => {
+                    log::info!("gdb: client lost, {error}");
+                    self.client = None;
+                    return got;
+                }
+            }
+        }
+    }
+
+    /// answers every whole packet in the buffer.
+    fn handle(&mut self, mut system: Option<&mut System>) {
+        loop {
+            let Some(first) = self.buffer.first().copied() else { return };
+            match first {
+                // acknowledgements of what we sent
+                b'+' | b'-' => {
+                    self.buffer.remove(0);
+                }
+                // the interrupt byte, outside any packet
+                0x03 => {
+                    self.buffer.remove(0);
+                    self.halted = true;
+                    self.send("S05");
+                }
+                b'$' => {
+                    let Some(hash) = self.buffer.iter().position(|&b| b == b'#') else { return };
+                    if self.buffer.len() < hash + 3 {
+                        return;
+                    }
+                    let body = self.buffer[1..hash].to_vec();
+                    let sum = std::str::from_utf8(&self.buffer[hash + 1..hash + 3]).ok().and_then(|s| u8::from_str_radix(s, 16).ok());
+                    self.buffer.drain(..hash + 3);
+                    let ours = body.iter().fold(0u8, |acc, &b| acc.wrapping_add(b));
+                    if sum != Some(ours) {
+                        self.raw(b"-");
+                        continue;
+                    }
+                    self.raw(b"+");
+                    let reply = self.answer(&body, system.as_deref_mut());
+                    if let Some(reply) = reply {
+                        self.send(&reply);
+                    }
+                }
+                // anything else before a packet is noise
+                _ => {
+                    self.buffer.remove(0);
+                }
+            }
+        }
+    }
+
+    /// the reply to one packet, none for `c`, which answers only when the
+    /// game stops again.
+    fn answer(&mut self, body: &[u8], system: Option<&mut System>) -> Option<String> {
+        let text = String::from_utf8_lossy(body);
+        let command = body.first().copied().unwrap_or(0);
+        match command {
+            b'?' => Some("S05".to_owned()),
+            b'c' => {
+                self.halted = false;
+                None
+            }
+            b'D' => {
+                self.halted = false;
+                Some("OK".to_owned())
+            }
+            b'm' => Some(read(&text[1..], system)),
+            b'M' => Some(write(&text[1..], system)),
+            // registers, breakpoints and queries are not served
+            _ => Some(String::new()),
+        }
+    }
+
+    fn send(&mut self, reply: &str) {
+        let sum = reply.bytes().fold(0u8, |acc, b| acc.wrapping_add(b));
+        self.raw(format!("${reply}#{sum:02x}").as_bytes());
+    }
+
+    fn raw(&mut self, bytes: &[u8]) {
+        let Some(client) = &mut self.client else { return };
+        // the client reads as it goes, a blocking write of a reply is short
+        let _ = client.set_nonblocking(false);
+        let result = client.write_all(bytes);
+        let _ = client.set_nonblocking(true);
+        if let Err(error) = result {
+            log::info!("gdb: client lost, {error}");
+            self.client = None;
+        }
+    }
+}
+
+/// `addr,length`, in hexadecimal.
+fn range(text: &str) -> Option<(u32, usize)> {
+    let (addr, length) = text.split_once(',')?;
+    let addr = u32::from_str_radix(addr, 16).ok()?;
+    let length = usize::from_str_radix(length, 16).ok()?;
+    (length <= MAX_BLOCK).then_some((addr, length))
+}
+
+fn read(text: &str, system: Option<&mut System>) -> String {
+    let (Some((addr, length)), Some(system)) = (range(text), system) else { return "E01".to_owned() };
+    if length == 0 {
+        return String::new();
+    }
+    if !system.memory.is_readable(addr, length as u32) {
+        return "E00".to_owned();
+    }
+    let mut out = vec![0u8; length];
+    system.memory.read_bytes(addr, &mut out);
+    out.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn write(text: &str, system: Option<&mut System>) -> String {
+    let Some((head, data)) = text.split_once(':') else { return "E01".to_owned() };
+    let (Some((addr, length)), Some(system)) = (range(head), system) else { return "E01".to_owned() };
+    if data.len() != 2 * length {
+        return "E01".to_owned();
+    }
+    let Some(bytes) = (0..length).map(|i| u8::from_str_radix(&data[2 * i..2 * i + 2], 16).ok()).collect::<Option<Vec<u8>>>() else {
+        return "E01".to_owned();
+    };
+    if length == 0 {
+        return "OK".to_owned();
+    }
+    if !system.memory.is_writable(addr, length as u32) {
+        return "E00".to_owned();
+    }
+    system.write_from_service(addr, &bytes);
+    "OK".to_owned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::range;
+
+    #[test]
+    fn ranges() {
+        assert_eq!(range("91c000,400"), Some((0x91C000, 0x400)));
+        assert_eq!(range("91c000,2000"), None);
+        assert_eq!(range("zz,4"), None);
+    }
+}
