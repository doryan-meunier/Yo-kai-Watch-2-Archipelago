+/// --recompile: recompiles the game with its mods in the data folder, as the
+/// library's Recompile does, printing how far along it is, and gives the
+/// exit code, 0 when the library is installed.
+fn recompile_from_command_line(app: &App) -> i32 {
+    let Some(rom) = app.options.rom.as_deref().map(Path::new) else { return 2 };
+    let title = match zakuro_fs::Title::load(rom) {
+        Ok(title) => title,
+        Err(error) => {
+            eprintln!("zakuro: {}: {error}", rom.display());
+            return 1;
+        }
+    };
+    let program_id = title.program_id();
+    let tools = zig::tools_dir(app.data_dir.as_deref());
+    let toolchain = match recomp3ds::compile::check(None) {
+        Ok(compiler) => Toolchain::Ready(compiler),
+        Err(error) => match tools.as_deref().and_then(zig::installed) {
+            Some(compiler) => Toolchain::Ready(compiler),
+            None => match tools {
+                Some(tools) if zig::download_size().is_some() && zig::can_download() => Toolchain::Download(tools),
+                _ => {
+                    eprintln!("zakuro: recompiling needs a C compiler: {error}");
+                    return 1;
+                }
+            },
+        },
+    };
+    let name = format!("{program_id:016X}");
+    let job = Job::start(rom, None, program_id, &name, app.data_dir.as_deref(), toolchain);
+    let mut last = String::new();
+    loop {
+        let stage = job.stage();
+        let line = match &stage {
+            Stage::Downloading(arrived) => format!("progress {:.0} downloading the compiler", 100.0 * arrived),
+            Stage::Generating => "progress 5 generating".to_owned(),
+            Stage::Compiling { done, total } => format!("progress {:.0} compiling {done} of {total}", 100.0 * stage.fraction()),
+            Stage::Installing => "progress 95 installing".to_owned(),
+            Stage::Done => "progress 100 done".to_owned(),
+            Stage::Failed(error) => format!("failed {error}"),
+        };
+        if line != last {
+            println!("{line}");
+            last = line;
+        }
+        match stage {
+            Stage::Done => return 0,
+            Stage::Failed(_) => return 1,
+            _ => std::thread::sleep(Duration::from_millis(200)),
+        }
+    }
+}
