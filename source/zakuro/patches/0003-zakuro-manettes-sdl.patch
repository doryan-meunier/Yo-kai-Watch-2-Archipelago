+/// an open controller.
+struct Pad {
+    gamepad: *mut SDL_Gamepad,
+    id: SDL_JoystickID,
+    /// L2 and R2 held, after the thresholds above.
+    triggers: [bool; 2],
+}
+
+impl Pad {
+    /// opens the controller SDL numbers id, none when it can't.
+    fn open(id: SDL_JoystickID) -> Option<Pad> {
+        // SAFETY: SDL is started; an unknown id gives null
+        let gamepad = unsafe { SDL_OpenGamepad(id) };
+        if gamepad.is_null() {
+            log::warn!("a controller can't be opened, {}", sdl_error());
+            return None;
+        }
+        Some(Pad { gamepad, id, triggers: [false; 2] })
+    }
+
+    /// its name, as "DualSense Wireless Controller".
+    fn name(&self) -> String {
+        // SAFETY: an open gamepad
+        sdl_string(unsafe { SDL_GetGamepadName(self.gamepad) })
+    }
+
+    /// its kind as SDL tells it ("ps5", "xbox360", "switchpro"…) and how it
+    /// is connected.
+    fn kind(&self) -> String {
+        // SAFETY: an open gamepad
+        let (kind, connection) = unsafe {
+            (SDL_GetGamepadStringForType(SDL_GetGamepadType(self.gamepad)), SDL_GetGamepadConnectionState(self.gamepad))
+        };
+        let connection = if connection == SDL_JOYSTICK_CONNECTION_WIRED {
+            "wired"
+        } else if connection == SDL_JOYSTICK_CONNECTION_WIRELESS {
+            "wireless"
+        } else {
+            "connection unknown"
+        };
+        format!("{}, {connection}", sdl_string(kind))
+    }
+
+    /// an axis, -1 to 1 (0 to 1 for the triggers), down positive as SDL has
+    /// it.
+    fn axis(&self, axis: SDL_GamepadAxis) -> f32 {
+        // SAFETY: an open gamepad
+        let value = unsafe { SDL_GetGamepadAxis(self.gamepad, axis) };
+        (f32::from(value) / 32767.0).clamp(-1.0, 1.0)
+    }
+
+    /// whether it holds an SDL button down.
+    fn holds(&self, button: SDL_GamepadButton) -> bool {
+        // SAFETY: an open gamepad; SDL gives false for a button it doesn't have
+        unsafe { SDL_GetGamepadButton(self.gamepad, button) }
+    }
+
+    /// whether it holds button down.
+    fn is_pressed(&self, button: Button) -> bool {
+        match button {
+            Button::LeftTrigger2 => self.triggers[0],
+            Button::RightTrigger2 => self.triggers[1],
+            other => sdl_button(other).is_some_and(|sdl| self.holds(sdl)),
+        }
+    }
+
+    /// takes in L2 and R2's travel, and gives those that went down since
+    /// the last call.
+    fn update_triggers(&mut self) -> Vec<Button> {
+        let mut pressed = Vec::new();
+        let triggers =
+            [(SDL_GAMEPAD_AXIS_LEFT_TRIGGER, Button::LeftTrigger2), (SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, Button::RightTrigger2)];
+        for (i, (axis, button)) in triggers.into_iter().enumerate() {
+            let value = self.axis(axis);
+            let held = value > if self.triggers[i] { TRIGGER_UP } else { TRIGGER_DOWN };
+            if held && !self.triggers[i] {
+                pressed.push(button);
+            }
+            self.triggers[i] = held;
+        }
+        pressed
+    }
+
+    /// the circle pad (left stick) and the C-stick (right stick), up
+    /// positive as the console has it, none inside the dead zone.
+    fn sticks(&self) -> [Option<(f32, f32)>; 2] {
+        [(SDL_GAMEPAD_AXIS_LEFTX, SDL_GAMEPAD_AXIS_LEFTY), (SDL_GAMEPAD_AXIS_RIGHTX, SDL_GAMEPAD_AXIS_RIGHTY)].map(
+            |(x, y)| {
+                let (x, y) = (self.axis(x), -self.axis(y));
+                (x.hypot(y) > DEADZONE).then_some((x.clamp(-1.0, 1.0), y.clamp(-1.0, 1.0)))
+            },
+        )
+    }
+}
+
+impl Drop for Pad {
+    fn drop(&mut self) {
+        // SAFETY: opened by SDL_OpenGamepad, closed once
+        unsafe { SDL_CloseGamepad(self.gamepad) };
+    }
+}
