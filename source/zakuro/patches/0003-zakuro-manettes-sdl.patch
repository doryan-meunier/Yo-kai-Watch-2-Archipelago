+        ("left stick y (down +)", SDL_GAMEPAD_AXIS_LEFTY),
+        ("right stick x", SDL_GAMEPAD_AXIS_RIGHTX),
+        ("right stick y (down +)", SDL_GAMEPAD_AXIS_RIGHTY),
+        ("L2 / LT", SDL_GAMEPAD_AXIS_LEFT_TRIGGER),
+        ("R2 / RT", SDL_GAMEPAD_AXIS_RIGHT_TRIGGER),
+    ];
+    let start = std::time::Instant::now();
+    // per controller: buttons held and axes last shown
+    let mut shown: Vec<(SDL_JoystickID, [bool; NAMES.len()], [f32; AXES.len()])> = Vec::new();
+    let mut seen = false;
+    while start.elapsed().as_secs() < seconds {
+        for event in sdl.events() {
