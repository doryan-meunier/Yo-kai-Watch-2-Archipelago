+            if kind == SDL_EVENT_GAMEPAD_ADDED {
+                let id = unsafe { event.gdevice.which };
+                if self.pads.iter().all(|pad| pad.id != id) {
+                    if let Some(pad) = Pad::open(id) {
+                        self.pads.push(pad);
+                        events.push(PadEvent::Connected(self.pads.len() - 1));
+                    }
+                }
+            } else if kind == SDL_EVENT_GAMEPAD_REMOVED {
+                let id = unsafe { event.gdevice.which };
+                self.pads.retain(|pad| pad.id != id);
+                events.push(PadEvent::Disconnected(id));
+            } else if kind == SDL_EVENT_GAMEPAD_BUTTON_DOWN {
+                events.push(PadEvent::Pressed(SDL_GamepadButton(c_int::from(unsafe { event.gbutton.button }))));
