+/// the hints SDL is started with.
+const HINTS: [(*const c_char, *const c_char); 9] = [
+    // the window in the background still gets the controllers, as when a
+    // person looks at another window while the game runs
+    (SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, c"1".as_ptr()),
+    // SDL's own drivers, which read the controllers' reports directly, for
+    // PlayStation 4 and 5 and Switch Pro controllers, USB and Bluetooth
+    (SDL_HINT_JOYSTICK_HIDAPI, c"1".as_ptr()),
+    (SDL_HINT_JOYSTICK_HIDAPI_PS4, c"1".as_ptr()),
+    (SDL_HINT_JOYSTICK_HIDAPI_PS5, c"1".as_ptr()),
+    (SDL_HINT_JOYSTICK_HIDAPI_SWITCH, c"1".as_ptr()),
+    // SDL 3 turns a Bluetooth PlayStation controller's enhanced reports on
+    // by default, which breaks DirectInput for the other programs until the
+    // controller is turned off: "auto" leaves its mode alone, as no rumble,
+    // motion or touchpad is asked for
+    (SDL_HINT_JOYSTICK_ENHANCED_REPORTS, c"auto".as_ptr()),
+    // devices come and go on SDL's own thread, not on the window's
+    (SDL_HINT_JOYSTICK_THREAD, c"1".as_ptr()),
+    // no Ctrl+C handler of SDL's, no change to the system's timer
+    (SDL_HINT_NO_SIGNAL_HANDLERS, c"1".as_ptr()),
+    (SDL_HINT_TIMER_RESOLUTION, c"0".as_ptr()),
+];
