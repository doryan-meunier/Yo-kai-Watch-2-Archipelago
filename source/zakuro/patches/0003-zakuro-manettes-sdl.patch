+/// a string SDL gives, or "?".
+fn sdl_string(text: *const c_char) -> String {
+    if text.is_null() {
+        return "?".to_owned();
+    }
+    // SAFETY: a non-null string SDL gives is nul-terminated and lives as
+    // long as what it describes
+    unsafe { CStr::from_ptr(text) }.to_string_lossy().into_owned()
+}
+
+/// SDL's last error.
+fn sdl_error() -> String {
+    sdl_string(sdl3_sys::error::SDL_GetError())
+}
