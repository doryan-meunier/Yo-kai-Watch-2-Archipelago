+impl Sdl {
+    /// starts SDL's gamepad subsystem with the hints above, once.
+    fn start() -> Result<Sdl, String> {
+        for (name, value) in HINTS {
+            // SAFETY: two nul-terminated strings, which SDL copies
+            unsafe { SDL_SetHint(name, value) };
+        }
