+/// SDL's version, as "3.4.18".
+pub fn sdl_version() -> String {
+    let version = sdl3_sys::version::SDL_GetVersion();
+    format!("{}.{}.{}", version / 1_000_000, version / 1000 % 1000, version % 1000)
+}
