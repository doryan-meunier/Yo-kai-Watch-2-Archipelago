+    /// takes in SDL's events: controllers come (SDL says so of those there
+    /// at the start too) and go, buttons go down.
+    fn events(&mut self) -> Vec<PadEvent> {
+        let mut events = Vec::new();
+        // SAFETY: an all-zero event is a valid one for SDL to fill
+        let mut event: SDL_Event = unsafe { std::mem::zeroed() };
+        // SAFETY: SDL is started, the event is ours to fill
+        while unsafe { SDL_PollEvent(&mut event) } {
