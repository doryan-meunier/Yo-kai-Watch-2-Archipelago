+/// a controller button, by where it sits on a standard controller, with
+/// the names gilrs gave them, which the settings file keeps
+/// (`[pad] a = "East"`). C and Z are never pressed (no standard controller
+/// has them); Touchpad is the DualSense's and DualShock 4's touchpad click.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default, Serialize, Deserialize)]
+pub enum Button {
+    South,
+    East,
+    North,
+    West,
+    C,
+    Z,
+    LeftTrigger,
+    LeftTrigger2,
+    RightTrigger,
+    RightTrigger2,
+    Select,
+    Start,
+    Mode,
+    LeftThumb,
+    RightThumb,
+    DPadUp,
+    DPadDown,
+    DPadLeft,
+    DPadRight,
+    Touchpad,
+    #[default]
+    Unknown,
+}
+
+/// SDL's button for one of ours, none for L2 / R2 (axes) and the buttons no
+/// standard controller has.
+fn sdl_button(button: Button) -> Option<SDL_GamepadButton> {
+    Some(match button {
+        Button::South => SDL_GAMEPAD_BUTTON_SOUTH,
+        Button::East => SDL_GAMEPAD_BUTTON_EAST,
+        Button::North => SDL_GAMEPAD_BUTTON_NORTH,
+        Button::West => SDL_GAMEPAD_BUTTON_WEST,
+        Button::LeftTrigger => SDL_GAMEPAD_BUTTON_LEFT_SHOULDER,
+        Button::RightTrigger => SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER,
+        Button::Select => SDL_GAMEPAD_BUTTON_BACK,
+        Button::Start => SDL_GAMEPAD_BUTTON_START,
+        Button::Mode => SDL_GAMEPAD_BUTTON_GUIDE,
+        Button::LeftThumb => SDL_GAMEPAD_BUTTON_LEFT_STICK,
+        Button::RightThumb => SDL_GAMEPAD_BUTTON_RIGHT_STICK,
+        Button::DPadUp => SDL_GAMEPAD_BUTTON_DPAD_UP,
+        Button::DPadDown => SDL_GAMEPAD_BUTTON_DPAD_DOWN,
+        Button::DPadLeft => SDL_GAMEPAD_BUTTON_DPAD_LEFT,
+        Button::DPadRight => SDL_GAMEPAD_BUTTON_DPAD_RIGHT,
+        Button::Touchpad => SDL_GAMEPAD_BUTTON_TOUCHPAD,
+        Button::LeftTrigger2 | Button::RightTrigger2 | Button::C | Button::Z | Button::Unknown => return None,
+    })
+}
+
+/// our button for one of SDL's, none for those we do not bind (paddles,
+/// share / capture / microphone buttons).
+fn from_sdl(button: SDL_GamepadButton) -> Option<Button> {
+    const BOUND: [Button; 16] = [
+        Button::South,
+        Button::East,
+        Button::North,
+        Button::West,
+        Button::LeftTrigger,
+        Button::RightTrigger,
+        Button::Select,
+        Button::Start,
+        Button::Mode,
+        Button::LeftThumb,
+        Button::RightThumb,
+        Button::DPadUp,
+        Button::DPadDown,
+        Button::DPadLeft,
+        Button::DPadRight,
+        Button::Touchpad,
+    ];
+    BOUND.into_iter().find(|&ours| sdl_button(ours) == Some(button))
+}
