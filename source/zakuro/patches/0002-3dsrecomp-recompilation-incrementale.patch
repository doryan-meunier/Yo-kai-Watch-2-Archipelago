+/// the addresses a source file holds the functions of, as the start of
+/// their window, so that the files of code a change does not reach stay
+/// the same, byte for byte.
+const WINDOW: u32 = 0x4000;
+
+/// where a function's stale flag and start are, from the file it is in.
+struct Slot {
+    starts: String,
+    stale: String,
+    index: usize,
+}
+
+/// a source file being written.
+struct File {
+    name: String,
+    window: u32,
+    part: usize,
+    /// the number of its first function in its unit.
+    first: usize,
+    starts: String,
+    stale: String,
+    body: String,
+    size: usize,
+    called: std::cell::RefCell<BTreeSet<String>>,
+}
+
+/// a file's names for its place in its unit's arrays, and that place.
+struct Alias {
+    starts: String,
+    stale: String,
+    first: usize,
+}
+
+/// what entries.c defines a file's names with: symbols at an offset into
+/// the arrays, which the assembler and linker resolve, so that the files
+/// themselves hold no number that depends on the functions before them.
+const ALIAS_MACROS: &str = r#"
+#ifndef RECOMP_ALIAS
+#define RECOMP_STRING_(x) #x
+#define RECOMP_STRING(x) RECOMP_STRING_(x)
+#define RECOMP_SYMBOL(name) RECOMP_STRING(__USER_LABEL_PREFIX__) #name
+#ifdef __ELF__
+#define RECOMP_ALIAS_HIDDEN(name) ".hidden " RECOMP_SYMBOL(name) "\n"
+#else
+#define RECOMP_ALIAS_HIDDEN(name) ""
+#endif
+#define RECOMP_ALIAS(name, array, offset) __asm__(".globl " RECOMP_SYMBOL(name) "\n" RECOMP_ALIAS_HIDDEN(name) ".set " RECOMP_SYMBOL(name) ", " RECOMP_SYMBOL(array) " + " #offset "\n");
+#endif
+"#;
+
+impl File {
+    fn new(prefix: &str, window: u32, part: usize, first: usize) -> File {
+        let stem = format!("{prefix}{window:08X}_{part}");
+        File {
+            name: format!("code_{stem}.c"),
+            window,
+            part,
+            first,
+            starts: format!("{prefix}recomp_starts_{stem}"),
+            stale: format!("{prefix}recomp_stale_{stem}"),
+            body: String::new(),
+            size: 0,
+            called: Default::default(),
+        }
+    }
+
+    /// the file, its declarations first, added to sources.
+    fn finish(self, prefix: &str, relative: bool, sources: &mut Vec<(String, String)>) -> Alias {
+        let mut text = String::from("#include \"recomp.h\"\n");
+        if relative {
+            emit!(text, "extern uint32_t {prefix}base;");
+        }
+        emit!(text, "extern RECOMP_HIDDEN uint8_t {}[];", self.stale);
+        emit!(text, "extern RECOMP_HIDDEN uint32_t {}[];", self.starts);
+        for called in self.called.borrow().iter() {
+            emit!(text, "void {called}(Context *ctx);");
+        }
+        text.push('\n');
+        text.push_str(&self.body);
+        sources.push((self.name, text));
+        Alias { starts: self.starts, stale: self.stale, first: self.first }
+    }
+}
+
 /// instructions per source file, so the files compile in parallel. gcc
 /// keeps a whole file in memory, and files of 20,000 took it up to 7.8 GB.
 const FILE_SIZE: usize = 5_000;
