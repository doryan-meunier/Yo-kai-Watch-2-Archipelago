+        assert_eq!(before[&second], after[&second]);
+        assert!(before["entries.c"].contains(&format!("RECOMP_ALIAS(recomp_starts_{:08X}_0, recomp_starts, 4)", BASE + WINDOW)));
+        assert!(after["entries.c"].contains(&format!("RECOMP_ALIAS(recomp_starts_{:08X}_0, recomp_starts, 8)", BASE + WINDOW)));
+    }
