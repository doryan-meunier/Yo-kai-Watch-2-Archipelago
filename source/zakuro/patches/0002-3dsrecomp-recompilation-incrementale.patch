+        std::fs::create_dir_all(&dir).unwrap();
+        for (name, text) in &files {
+            std::fs::write(dir.join(name), text).unwrap();
+        }
+        let Ok(compiler) = crate::compile::check(None) else { return };
+        let sources = vec![C0.to_owned(), "entries.c".to_owned()];
