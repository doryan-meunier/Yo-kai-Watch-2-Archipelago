+        words[1] = 0xE12F_FF1E;
+        words[2] = 0xE12F_FF1E;
+        let after = generate_for(&words, vec![(BASE, Source::Entry), (BASE + 8, Source::Entry), (BASE + WINDOW, Source::Entry)]);
