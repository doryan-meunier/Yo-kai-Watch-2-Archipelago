+/// what an object depends on besides its source: the compiler, how it is
+/// called, and the header every source includes.
+fn stamp(compiler: &Compiler, dir: &Path, gcc: bool) -> String {
+    let version = compiler.command().arg("--version").output().map(|o| String::from_utf8_lossy(&o.stdout).into_owned());
+    let header = std::fs::read(dir.join("recomp.h")).unwrap_or_default();
+    let mut hash = recomp_abi::CodeHash::default();
+    hash.add(&header);
+    format!(
+        "{}\n{}\n{:?} {:?} {:?}\nrecomp.h {} {:016X}\n",
+        compiler.describe(),
+        version.unwrap_or_default().trim(),
+        FLAGS,
+        if gcc { GCC_FLAGS } else { &[] },
+        if cfg!(windows) { &[][..] } else { UNIX_FLAGS },
+        header.len(),
+        hash.value()
+    )
+}
+
+/// where it is noted what a source's object was made with.
+fn stamp_path(source: &Path) -> PathBuf {
+    source.with_extension("stamp")
+}
+
+/// whether source has an object made from it as it is, with stamp.
+fn up_to_date(source: &Path, stamp: &str) -> bool {
+    let object = source.with_extension("o");
+    let newer = |a: &Path, b: &Path| {
+        let time = |p: &Path| std::fs::metadata(p).and_then(|m| m.modified()).ok();
+        matches!((time(a), time(b)), (Some(a), Some(b)) if a >= b)
+    };
+    std::fs::read_to_string(stamp_path(source)).is_ok_and(|noted| noted == stamp) && newer(&object, source)
+}
+
+/// notes that source's object was just made with stamp.
+fn remember(source: &Path, stamp: &str) {
+    let _ = std::fs::write(stamp_path(source), stamp);
+}
+
+/// forgets source's object, which no longer goes with it.
+pub fn forget(source: &Path) {
+    let _ = std::fs::remove_file(stamp_path(source));
+    let _ = std::fs::remove_file(source.with_extension("o"));
+}
