+                x: offset_x + (total_width - 320.0) / 2.0 * scale,
+                y: offset_y + 240.0 * scale,
+                width: 320.0 * scale,
+                height: 240.0 * scale,
+            }),
+            ScreenLayout::SideBySide => Some(Viewport {
+                x: offset_x + top_w * scale,
+                y: offset_y,
+                width: 320.0 * scale,
+                height: 240.0 * scale,
+            }),
