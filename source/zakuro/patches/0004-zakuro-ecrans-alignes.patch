+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum ScreenAlign {
+    /// in the middle, room on both sides.
+    #[default]
+    Center,
+    /// against the window's left edge, the room on the right.
+    Left,
+    /// against the window's right edge, the room on the left.
+    Right,
+}
