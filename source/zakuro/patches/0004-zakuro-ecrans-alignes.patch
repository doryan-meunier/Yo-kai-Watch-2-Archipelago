+        for (width, height) in WINDOWS {
+            for arrangement in LAYOUTS {
+                for top_w in TOPS {
+                    for integer in [false, true] {
+                        let what = format!("{width}x{height} {arrangement:?} {top_w} {integer}");
+                        let centred = layout_aligned(width, height, arrangement, top_w, integer, ScreenAlign::Center);
+                        let left = layout_aligned(width, height, arrangement, top_w, integer, ScreenAlign::Left);
+                        let right = layout_aligned(width, height, arrangement, top_w, integer, ScreenAlign::Right);
+                        let screens = |(top, bottom): (Option<Viewport>, Option<Viewport>)| top.into_iter().chain(bottom).collect::<Vec<_>>();
+                        let (c, l, r) = (screens(centred), screens(left), screens(right));
+                        assert_eq!(c.len(), l.len());
+                        assert_eq!(c.len(), r.len());
+                        let min_x = |s: &[Viewport]| s.iter().map(|v| v.x).fold(f32::INFINITY, f32::min);
+                        let max_x = |s: &[Viewport]| s.iter().map(|v| v.x + v.width).fold(f32::NEG_INFINITY, f32::max);
+                        // against the edges
+                        assert_eq!(min_x(&l), 0.0, "{what}");
+                        let total = arrangement.size_f(top_w).0;
+                        let scale = c.iter().map(|v| v.height / 240.0).fold(0.0, f32::max);
+                        let free = width as f32 - total * scale;
+                        let wanted_right = if integer { free.floor() } else { free };
+                        // (rounded down to a whole pixel for whole number scaling, the
+                        // free room worked out here may be a hair off)
+                        let slack = if integer { 1.0 } else { 1e-3 };
+                        assert!((min_x(&r) - wanted_right).abs() <= slack, "{what}: {} vs {wanted_right}", min_x(&r));
+                        assert!(max_x(&r) <= width as f32 + 1e-3, "{what}");
+                        if !integer {
+                            assert!((max_x(&r) - width as f32).abs() < 1e-2, "{what}");
+                        }
+                        // only moved sideways, all by the same amount
+                        for side in [&l, &r] {
+                            let shift = side[0].x - c[0].x;
+                            for (moved, before) in side.iter().zip(&c) {
+                                assert_eq!((moved.y, moved.width, moved.height), (before.y, before.width, before.height), "{what}");
+                                assert!((moved.x - before.x - shift).abs() < 1e-3, "{what}");
+                            }
+                            // the group starts on a whole pixel for whole number
+                            // scaling, as centred
+                            if integer {
+                                assert!(min_x(side).fract() == 0.0 && side[0].y.fract() == 0.0, "{what}");
+                            }
+                        }
+                        // the room left over, all on the other side
+                        // (whole number scaling may round the small screen of the big top
+                        // one down, short of the group's edge)
+                        assert!(max_x(&l) <= total * scale + 1e-2, "{what}");
+                        if !integer {
+                            assert!((max_x(&l) - total * scale).abs() < 1e-2, "{what}");
+                        }
+                    }
+                }
+            }
+        }
+    }
