+                    for integer in [false, true] {
+                        for align in ALIGNS {
+                            let (_, bottom) = layout_aligned(window.0, window.1, arrangement, top_width, integer, align);
+                            let point = |cursor| touch_point(window, cursor, arrangement, top_width, integer, align);
+                            let Some(bottom) = bottom else {
+                                assert_eq!(point((window.0 as f32 / 2.0, window.1 as f32 / 2.0)), None);
+                                continue;
+                            };
+                            let what = format!("{window:?} {arrangement:?} {top_width} {integer} {align:?}");
+                            for (px, py) in [(0u16, 0u16), (319, 239), (160, 120), (17, 203), (300, 5)] {
+                                let cursor = (
+                                    bottom.x + (px as f32 + 0.5) * bottom.width / 320.0,
+                                    bottom.y + (py as f32 + 0.5) * bottom.height / 240.0,
+                                );
+                                assert_eq!(point(cursor), Some((px, py)), "{what} pixel {px},{py}");
+                            }
+                            // just outside each edge
+                            for cursor in [
+                                (bottom.x - 0.5, bottom.y + 1.0),
+                                (bottom.x + bottom.width + 0.5, bottom.y + 1.0),
+                                (bottom.x + 1.0, bottom.y - 0.5),
+                                (bottom.x + 1.0, bottom.y + bottom.height + 0.5),
+                            ] {
+                                assert_eq!(point(cursor), None, "{what} {cursor:?}");
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    /// the bottom screen moved to an edge is touched where it now shows:
+    /// a 1920x1080 window, top over bottom at 2.25 times, 900 pixels wide.
+    #[test]
+    fn the_touch_screen_moves_with_the_screens() {
+        let at = |align, x, y| touch_point((1920, 1080), (x, y), ScreenLayout::Stacked, 400.0, false, align);
+        // centred, the bottom screen spans 600 to 1320 across, from 540 down
+        assert_eq!(at(ScreenAlign::Center, 600.0, 540.0), Some((0, 0)));
+        assert_eq!(at(ScreenAlign::Center, 100.0, 600.0), None);
+        // to the left, 90 to 810: most of where the centred one was is now off it
+        assert_eq!(at(ScreenAlign::Left, 90.0, 540.0), Some((0, 0)));
+        assert_eq!(at(ScreenAlign::Left, 1000.0, 600.0), None);
+        assert_eq!(at(ScreenAlign::Left, 809.9, 1079.9), Some((319, 239)));
+        // to the right, 1110 to 1830
+        assert_eq!(at(ScreenAlign::Right, 1110.0, 540.0), Some((0, 0)));
+        assert_eq!(at(ScreenAlign::Right, 700.0, 600.0), None);
+        assert_eq!(at(ScreenAlign::Right, 1829.9, 1079.9), Some((319, 239)));
+        // the same pointer, the same touch screen pixel, wherever it is
+        for (align, from) in [(ScreenAlign::Center, 600.0), (ScreenAlign::Left, 90.0), (ScreenAlign::Right, 1110.0)] {
+            assert_eq!(at(align, from + 360.0, 810.0), Some((160, 120)));
+        }
+    }
 }
