+impl ScreenAlign {
+    /// how far from the left edge screens free_width narrower than the
+    /// window start.
+    fn offset(self, free_width: f32) -> f32 {
+        match self {
+            ScreenAlign::Center => free_width / 2.0,
+            ScreenAlign::Left => 0.0,
+            ScreenAlign::Right => free_width,
+        }
+    }
