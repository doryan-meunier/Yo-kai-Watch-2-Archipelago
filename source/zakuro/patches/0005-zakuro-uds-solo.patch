+    let Some(missed) = due(&LAST, (command, code), FAILURE_LOG_SECONDS) else { return };
+    let uds = &system.services.uds;
+    let node = node.map_or(String::new(), |node| format!(", node 0x{node:04X}"));
+    log::info!(
+        "uds: command 0x{command:04X}{node} answered 0x{code:08X} ({} time(s) since the last line), status {} as node {}, {} node(s), room {}",
