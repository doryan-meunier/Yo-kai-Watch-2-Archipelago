+/// when the status event of a network just put up is due, in cycles: the
+/// service's state is saved with the console's, this is not (at worst a
+/// state loaded before it is due signals it once, which any title copes with).
+/// kept by console (its address), two consoles in one program in the tests.
+static STATUS_DUE: std::sync::Mutex<Option<std::collections::HashMap<usize, Vec<u64>>>> = std::sync::Mutex::new(None);
+/// after CreateNetwork2, the two times the status event of the new network
+/// is signalled.
+const STATUS_AFTER_NANOS: [u64; 2] = [50_000_000, 1_000_000_000];
+
+fn schedule_status(system: &mut System, now: u64) {
+    let key = system as *const System as usize;
+    if let Ok(mut due) = STATUS_DUE.lock() {
+        due.get_or_insert_with(std::collections::HashMap::new).insert(key, STATUS_AFTER_NANOS.iter().map(|&nanos| now + nanos_to_ticks(nanos)).collect());
+    }
+}
+
+/// signals the status event of a network put up, once it is due.
+fn signal_due_status(system: &mut System) {
+    let now = system.cpu.cycles;
+    let key = system as *const System as usize;
+    let fire = match STATUS_DUE.lock() {
+        Ok(mut table) => match table.as_mut().and_then(|table| table.get_mut(&key)) {
+            Some(due) => {
+                let before = due.len();
+                due.retain(|&at| at > now);
+                before != due.len()
+            }
+            None => false,
+        },
+        Err(_) => false,
+    };
+    if fire && system.services.uds.initialized && system.services.uds.status.status == HOST {
+        signal_status(system);
+    }
+}
