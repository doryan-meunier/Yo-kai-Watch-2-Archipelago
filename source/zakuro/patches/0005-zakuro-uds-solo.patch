+/// whether a line keyed so is due, at most one each `seconds`, and how many
+/// went unlogged since the last one.
+fn due<K: std::hash::Hash + Eq + Send + 'static>(
+    table: &'static std::sync::Mutex<Option<std::collections::HashMap<K, (std::time::Instant, u32)>>>,
+    key: K,
+    seconds: u64,
+) -> Option<u32> {
+    let mut table = table.lock().ok()?;
+    let now = std::time::Instant::now();
+    let table = table.get_or_insert_with(std::collections::HashMap::new);
+    match table.get_mut(&key) {
+        Some((at, skipped)) if now.duration_since(*at).as_secs() < seconds => {
+            *skipped += 1;
+            None
+        }
+        Some((at, skipped)) => {
+            let missed = *skipped;
+            *at = now;
+            *skipped = 0;
+            Some(missed)
+        }
+        None => {
+            table.insert(key, (now, 0));
+            Some(0)
+        }
+    }
+}
